# Copy to .env. Keep comments on their own lines.
BACKEND_URL=http://localhost:8000
# Same value as DEVICE_API_KEY in the backend .env
DEVICE_API_KEY=change-me
IMAGE_DIR=./images

# Prototype engine for crop, stage, leaf health and rain (no training needed)
USE_CLIP=true
CLIP_MODEL=ViT-B-32
CLIP_PRETRAINED=laion2b_s34b_b79k

# YOLO models
# COCO model for animals, downloaded automatically on first use
ANIMAL_MODEL=yolov8n.pt
# After training (training/train_models.ipynb): models/pest.pt
PEST_MODEL=
# After training: models/crop.pt (replaces CLIP for crop + stage)
CROP_MODEL=

DETECT_MIN_CONF=0.35
RAIN_MIN_CONF=0.70
MOTION_MIN_CHANGED_PCT=2.0
CROP_MIN_CONF=0.50
CROP_MIN_MARGIN=0.15
