# Copy to .env and adjust.
DATABASE_URL=sqlite:///./kizuna.db

# Farm location (ET0 + weather forecast). Default = Tunis area.
FARM_LATITUDE=36.81
FARM_LONGITUDE=10.18
FARM_ALTITUDE_M=10
FARM_COASTAL=true
FARM_TIMEZONE=Africa/Tunis

# Operating rules (choices, not agronomic constants)
IRRIGATION_WINDOWS=05:00-09:00,18:00-21:00
RAIN_POSTPONE_PROBABILITY_PCT=60
READING_MAX_AGE_MIN=30
MIN_TANK_LEVEL_PCT=10
MAX_VOLUME_PER_EVENT_L=500
TIMEOUT_FACTOR=1.5

# Post-irrigation verification
DELIVERY_TOLERANCE=0.10
MOISTURE_CHECK_DELAY_MIN=30
MOISTURE_RESPONSE_MIN_RATIO=0.5
LEAK_FLOW_THRESHOLD_LPM=0.5

# AI identification: below this confidence the farmer must confirm
AI_CONFIDENCE_THRESHOLD=0.80

# Background scheduler
SCHEDULER_ENABLED=true
DECISION_INTERVAL_MIN=15
WEATHER_INTERVAL_MIN=180

# Shared secret sent by the ESP32 in the X-Device-Key header
DEVICE_API_KEY=change-me
